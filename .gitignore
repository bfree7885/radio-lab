# Virtual environment
.venv/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/

# Runtime data and logs
data/*.sqlite
data/*.sqlite3
data/*.db
logs/
*.log

# Generated learner site
dist/

# Temporary files
tmp/
.tmp/
*.tmp
*.swp
*~

# Editor and OS junk
.idea/
.vscode/
.DS_Store

# Secrets
.env
.env.*
*.pem
credentials.json

# Local NCVEC source PDFs. Question stems and official diagrams are tracked.
# The PDF stays on the development machine and is not part of the public repository.
content/exam/sources/**/*.pdf
